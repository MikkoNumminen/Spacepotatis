{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "tutorial",
              "tubernovae"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sunColor": {
            "type": "string"
          },
          "sunSize": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ambientHue": {
            "type": "string"
          },
          "galaxyMusicTrack": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "sunColor",
          "sunSize",
          "ambientHue",
          "galaxyMusicTrack"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "systems"
  ],
  "additionalProperties": false
}
