{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "tutorial",
              "combat-1",
              "boss-1",
              "shop",
              "market",
              "pirate-beacon",
              "ember-run",
              "burnt-spud",
              "tubernovae-outpost"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "mission",
              "shop",
              "scenery"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "texture": {
            "type": "string"
          },
          "solarSystemId": {
            "type": "string",
            "enum": [
              "tutorial",
              "tubernovae"
            ]
          },
          "orbitRadius": {
            "type": "number"
          },
          "orbitSpeed": {
            "type": "number"
          },
          "startAngle": {
            "type": "number"
          },
          "orbitTilt": {
            "type": "number"
          },
          "orbitNode": {
            "type": "number"
          },
          "orbitParentId": {
            "type": "string",
            "enum": [
              "tutorial",
              "combat-1",
              "boss-1",
              "shop",
              "market",
              "pirate-beacon",
              "ember-run",
              "burnt-spud",
              "tubernovae-outpost"
            ]
          },
          "scale": {
            "type": "number"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "tutorial",
                "combat-1",
                "boss-1",
                "shop",
                "market",
                "pirate-beacon",
                "ember-run",
                "burnt-spud",
                "tubernovae-outpost"
              ]
            }
          },
          "musicTrack": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "ring": {
            "type": "object",
            "properties": {
              "innerRadius": {
                "type": "number"
              },
              "outerRadius": {
                "type": "number"
              },
              "tilt": {
                "type": "number"
              }
            },
            "required": [
              "innerRadius",
              "outerRadius",
              "tilt"
            ],
            "additionalProperties": false
          },
          "perksAllowed": {
            "type": "boolean"
          },
          "planetStyle": {
            "type": "object",
            "properties": {
              "noiseScale": {
                "type": "number"
              },
              "octaves": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "bandStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "featureColor": {
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "featureThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "featureMix": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "craters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "craterSizeRange": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              }
            },
            "required": [
              "noiseScale",
              "octaves",
              "bandStrength",
              "featureColor",
              "featureThreshold",
              "featureMix",
              "craters",
              "craterSizeRange"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "difficulty",
          "texture",
          "solarSystemId",
          "orbitRadius",
          "orbitSpeed",
          "startAngle",
          "scale",
          "requires",
          "musicTrack"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "missions"
  ],
  "additionalProperties": false
}
