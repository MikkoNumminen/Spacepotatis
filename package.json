{
  "name": "spacepotatis",
  "version": "0.1.0",
  "private": true,
  "description": "Tyrian 2000-inspired vertical scrolling space shooter with a Three.js galaxy overworld",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:migrate:dbmate": "dbmate up",
    "db:rollback": "dbmate down",
    "db:new": "dbmate new",
    "db:status": "dbmate status",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "gsap": "^3.12.5",
    "kysely": "^0.29.2",
    "next": "^16.2.6",
    "next-auth": "5.0.0-beta.31",
    "phaser": "^3.87.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,cjs}": "eslint --fix"
  }
}
